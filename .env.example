# Application
HH_ENV=production
HH_BASE_URL=https://hh.example.local
HH_SESSION_IDLE_TIMEOUT=1800
HH_COOKIE_SECURE=1

# Active Directory / LDAP
# Prefer LDAPS and use a hostname present in the server certificate.
HH_LDAP_URI=ldaps://dc01.example.local:636
HH_LDAP_BASE_DN=DC=example,DC=local
HH_LDAP_BIND_DN=CN=svc-hh-readonly,OU=Service Accounts,DC=example,DC=local
HH_LDAP_BIND_PASSWORD=REPLACE_OUTSIDE_GIT
HH_LDAP_USERNAME_ATTRIBUTE=sAMAccountName
HH_LDAP_DISPLAY_ATTRIBUTE=displayName
HH_LDAP_EMAIL_ATTRIBUTE=mail
HH_LDAP_USER_FILTER=(sAMAccountName={username})
HH_LDAP_STARTTLS=0
HH_LDAP_TIMEOUT=5

# HH MariaDB (not used yet; reserved for the next stage)
HH_DB_HOST=127.0.0.1
HH_DB_PORT=3306
HH_DB_NAME=hh
HH_DB_USER=hh_app
HH_DB_PASSWORD=REPLACE_OUTSIDE_GIT

# GLPI read-only connection (not used yet; inventory query will be supplied later)
GLPI_DB_HOST=192.0.2.10
GLPI_DB_PORT=3306
GLPI_DB_NAME=glpi
GLPI_DB_USER=hh_glpi_readonly
GLPI_DB_PASSWORD=REPLACE_OUTSIDE_GIT
