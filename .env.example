# Application
HH_ENV=production
# URL pública de HH en HTTPS. Debe corresponder al VirtualHost de Apache.
HH_BASE_URL=https://hh.example.local
HH_SESSION_IDLE_TIMEOUT=1800
HH_COOKIE_SECURE=1

# GLPI 11 OAuth 2.0 (Authorization Code)
GLPI_BASE_URL=https://soporte.songa.com
# Crear un cliente OAuth en GLPI y colocar aquí el Client ID y Client Secret.
# No colocar secretos reales en Git. Mantenerlos en /etc/hh/hh.env.
GLPI_OAUTH_CLIENT_ID=REPLACE_WITH_GLPI_CLIENT_ID
GLPI_OAUTH_CLIENT_SECRET=REPLACE_WITH_GLPI_CLIENT_SECRET
GLPI_OAUTH_SCOPE=api user email
# URI de retorno a registrar exactamente en el cliente OAuth:
# https://hh.example.local/glpi-callback.php

# HH MariaDB (reservada para la siguiente etapa)
HH_DB_HOST=127.0.0.1
HH_DB_PORT=3306
HH_DB_NAME=hh
HH_DB_USER=hh_app
HH_DB_PASSWORD=REPLACE_OUTSIDE_GIT

# GLPI inventory database is not used. HH will query inventory through the GLPI API
# only after the actual schema and required read-only endpoints are confirmed.
